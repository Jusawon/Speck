<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Speck.Customization"                          Background="#F9FAFB"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <ScrollViewer>
           <StackPanel Classes="VControlStack">
                  <TextBlock Classes="H1" Text="Customize Your Speck!"/>
                     <WrapPanel Classes="HControlStack">

          <WrapPanel Classes="SpeckSelection">
			  <ToggleButton Name="SelectKampoeng" Click="SelectKampoeng_Click" ToolTip.Tip="Change Speck into a Kampong Chicken">
				  <Image Source="{SvgImage //Speck/Assets/Specks/Normals/Basic/Kampong.svg}"/>
              </ToggleButton>
              <TextBlock Text="Kampong" Classes="A"/>
          </WrapPanel>

          <WrapPanel Classes="SpeckSelection">
			  <ToggleButton Name="SelectOrpington" Click="SelectOrpington_Click" ToolTip.Tip="Change Speck into an Orpington Chicken">
				  <Image Source="{SvgImage //Speck/Assets/Specks/Normals/Basic/Orpington.svg}"/>
              </ToggleButton>
              <TextBlock Text="Orpington" Classes="A"/>
          </WrapPanel>

          <WrapPanel Classes="SpeckSelection">
			  <ToggleButton Name="SelectLeghorn" Click="SelectLeghorn_Click" ToolTip.Tip="Change Speck into a Leghorn Chicken">
				  <Image Source="{SvgImage //Speck/Assets/Specks/Normals/Basic/Leghorn.svg}"/>
              </ToggleButton>
              <TextBlock Text="Leghorn" Classes="A"/>
          </WrapPanel>

          <WrapPanel Classes="SpeckSelection">
			  <ToggleButton Name="SelectAustraslop" Click="SelectAustraslop_Click" ToolTip.Tip="Change Speck into an Australorp Chicken">
				  <Image Source="{SvgImage //Speck/Assets/Specks/Normals/Basic/Australorp.svg}"/>
              </ToggleButton>
              <TextBlock Text="Australorp" Classes="A"/>
          </WrapPanel>

          <WrapPanel Classes="SpeckSelection">
			  <ToggleButton Name="SelectSussex" Click="SelectSussex_Click" ToolTip.Tip="Change Speck into a Sussex Chicken">
				  <Image Source="{SvgImage //Speck/Assets/Specks/Normals/Basic/Sussex.svg}"/>
              </ToggleButton>
              <TextBlock Text="Sussex" Classes="A"/>
          </WrapPanel>

        </WrapPanel>
                  </StackPanel>
    </ScrollViewer>
</UserControl>
