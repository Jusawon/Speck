<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="1024"
        x:Class="Speck.MainWindow"
        Title="Speck">
    <Grid ColumnDefinitions="200, Auto">
        <DockPanel Grid.Column="0" Background ="#D0FFC9">
            <DockPanel.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" Opacity="0.25" OffsetY="0"/>
             </DockPanel.Effect>

            <Image DockPanel.Dock="Top"
                   Source= "{SvgImage //Speck/Assets/Icons/App General/Speck Logo.svg}"
                   Height= "46"
                   Width= "142"
                   Margin="20"/> 

            <StackPanel Orientation="Vertical" Margin="20 20" Spacing="10"  DockPanel.Dock="Top">
              <ToggleButton Classes="MenuItems">
                  <StackPanel Classes="MenuItemContent">
                      <Image Classes="MenuItemIcon" Source="{SvgImage //Speck/Assets/Icons/Menu Items/Dashboard (Idle).svg}"/>
                      <TextBlock Classes="MenuItemText" Text="Dashboard"/>
                  </StackPanel>
              </ToggleButton>

            </StackPanel>

        </DockPanel>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background ="#F9FAFB">

            </ScrollViewer>
    </Grid>
</Window>
