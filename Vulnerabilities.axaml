<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Speck.Vulnerabilities"                          Background="#F9FAFB"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <ScrollViewer>
      <WrapPanel>
           <StackPanel Classes="VControlStack">
               <TextBlock Classes="H1" Text="Vulnerabilities"/>
               <TextBlock Classes="Desc" Text="Vulnerabilities displayed are based on the final scan. If you had updated or mitigated any vulnerabilities, please run a new scan."/>


                <TextBlock Classes="H2" Text="Executive Overview"/>
                  </StackPanel>
          </WrapPanel>
    </ScrollViewer>
</UserControl>
